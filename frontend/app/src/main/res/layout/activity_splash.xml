<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F9FF"
    android:padding="0dp">

    <!-- Background Blur Circles -->
    <View
        android:id="@+id/blobTop"
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="-40dp"
        android:layout_marginEnd="-40dp"
        android:background="@drawable/circle_blur_top"
        android:elevation="0dp" />

    <View
        android:id="@+id/blobBottom"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginBottom="-30dp"
        android:layout_marginStart="-30dp"
        android:background="@drawable/circle_blur_bottom"
        android:elevation="0dp" />

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="32dp">

        <!-- Logo Container -->
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:layout_gravity="center">

            <!-- Logo Background -->
            <RelativeLayout
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/ivSplashLogo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/florra_logo"
                    android:scaleType="centerInside"
                    android:elevation="16dp" />

            </RelativeLayout>

        </RelativeLayout>

        <!-- App Name -->
        <TextView
            android:id="@+id/txtAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Florra"
            android:textColor="#0F172A"
            android:textSize="42sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.02"
            android:lineHeight="42sp"
            android:layout_marginBottom="12dp"
            android:gravity="center" />

        <!-- Tagline Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/txtTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tile Designs &amp; Shop Management"
                android:textColor="#64748B"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:gravity="center"
                android:textAllCaps="true" />

            <!-- Divider Line -->
            <View
                android:layout_width="48dp"
                android:layout_height="2dp"
                android:layout_marginTop="8dp"
                android:background="#3B82F6"
                android:alpha="0.3" />

        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/txtDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Professional showroom utility for inventory, quotation &amp; sales insights."
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:lineHeight="18sp"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:maxWidth="240dp"
            android:paddingHorizontal="16dp" />

    </LinearLayout>

</RelativeLayout>