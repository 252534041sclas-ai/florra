<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_arrow_back"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Compare Products"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_centerInParent="true"/>
    </RelativeLayout>

    <!-- Comparison Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:weightSum="2">

        <!-- Product A (Left) -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginBottom="8dp">
                    <ImageView
                        android:id="@+id/imgProductA"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/tile_placeholder"/>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvNameA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Product Name"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/black"/>

                <TextView
                    android:id="@+id/tvPriceA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="₹0.00 / sq.ft"
                    android:textSize="12sp"
                    android:textColor="@color/primary"
                    android:layout_marginBottom="16dp"/>

                <!-- Attributes -->
                <TextView 
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Model" 
                    android:textSize="10sp" 
                    android:textColor="@color/gray_600"/>
                <TextView 
                    android:id="@+id/tvModelA" 
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="-" 
                    android:textSize="12sp" 
                    android:textColor="@color/black" 
                    android:layout_marginBottom="8dp"/>

                <TextView 
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Category" 
                    android:textSize="10sp" 
                    android:textColor="@color/gray_600"/>
                <TextView 
                    android:id="@+id/tvCategoryA" 
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="-" 
                    android:textSize="12sp" 
                    android:textColor="@color/black" 
                    android:layout_marginBottom="8dp"/>

                <TextView 
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Size" 
                    android:textSize="10sp" 
                    android:textColor="@color/gray_600"/>
                <TextView 
                    android:id="@+id/tvSizeA" 
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="-" 
                    android:textSize="12sp" 
                    android:textColor="@color/black" 
                    android:layout_marginBottom="8dp" />

                <TextView 
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Finish" 
                    android:textSize="10sp" 
                    android:textColor="@color/gray_600"/>
                <TextView 
                    android:id="@+id/tvFinishA" 
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="-" 
                    android:textSize="12sp" 
                    android:textColor="@color/black" 
                    android:layout_marginBottom="8dp"/>

                <TextView 
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Thickness" 
                    android:textSize="10sp" 
                    android:textColor="@color/gray_600"/>
                <TextView 
                    android:id="@+id/tvThicknessA" 
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="-" 
                    android:textSize="12sp" 
                    android:textColor="@color/black" 
                    android:layout_marginBottom="8dp"/>

                <TextView 
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Coverage" 
                    android:textSize="10sp" 
                    android:textColor="@color/gray_600"/>
                <TextView 
                    android:id="@+id/tvCoverageA" 
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="-" 
                    android:textSize="12sp" 
                    android:textColor="@color/black" 
                    android:layout_marginBottom="8dp"/>

                <TextView 
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Packing" 
                    android:textSize="10sp" 
                    android:textColor="@color/gray_600"/>
                <TextView 
                    android:id="@+id/tvPackingA" 
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="-" 
                    android:textSize="12sp" 
                    android:textColor="@color/black" 
                    android:layout_marginBottom="8dp"/>

            </LinearLayout>
        </ScrollView>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#E0E0E0"/>

        <!-- Product B (Right - Placeholder or Details) -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- Helper Layout for Adding Product -->
                <LinearLayout
                    android:id="@+id/layoutAddProduct"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:minHeight="200dp">
                    
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_add"
                        android:tint="@color/gray_400"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select Product"
                        android:textColor="@color/gray_600"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>

                <!-- Details Layout (Initially Gone) -->
                <LinearLayout
                    android:id="@+id/layoutProductBDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginBottom="8dp">
                        <ImageView
                            android:id="@+id/imgProductB"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/tile_placeholder"/>
                        
                        <ImageView
                            android:id="@+id/btnCloseB"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_close"
                            android:background="@drawable/bg_circle_button"
                            android:layout_gravity="end|top"
                            android:padding="4dp"
                            android:layout_margin="4dp"/>
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/tvNameB"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Product Name"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@color/black"/>

                    <TextView
                        android:id="@+id/tvPriceB"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="₹0.00 / sq.ft"
                        android:textSize="12sp"
                        android:textColor="@color/primary"
                        android:layout_marginBottom="16dp"/>

                    <!-- Attributes -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Model"
                        android:textSize="10sp"
                        android:textColor="@color/gray_600"/>
                    <TextView
                        android:id="@+id/tvModelB"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="12sp"
                        android:textColor="@color/black"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Category"
                        android:textSize="10sp"
                        android:textColor="@color/gray_600"/>
                    <TextView
                        android:id="@+id/tvCategoryB"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="12sp"
                        android:textColor="@color/black"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Size"
                        android:textSize="10sp"
                        android:textColor="@color/gray_600"/>
                    <TextView
                        android:id="@+id/tvSizeB"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="12sp"
                        android:textColor="@color/black"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Finish"
                        android:textSize="10sp"
                        android:textColor="@color/gray_600"/>
                    <TextView
                        android:id="@+id/tvFinishB"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="12sp"
                        android:textColor="@color/black"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Thickness"
                        android:textSize="10sp"
                        android:textColor="@color/gray_600"/>
                    <TextView
                        android:id="@+id/tvThicknessB"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="12sp"
                        android:textColor="@color/black"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Coverage"
                        android:textSize="10sp"
                        android:textColor="@color/gray_600"/>
                    <TextView
                        android:id="@+id/tvCoverageB"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="12sp"
                        android:textColor="@color/black"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Packing"
                        android:textSize="10sp"
                        android:textColor="@color/gray_600"/>
                    <TextView
                        android:id="@+id/tvPackingB"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="12sp"
                        android:textColor="@color/black"
                        android:layout_marginBottom="8dp"/>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

</LinearLayout>
