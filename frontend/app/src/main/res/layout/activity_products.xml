<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fitsSystemWindows="true">

    <!-- Header Section (Fixed - Does NOT scroll) -->
    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:elevation="4dp"
        android:layout_alignParentTop="true">

        <!-- Back button and Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="24dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical">

            <!-- Back Button -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/primary_color"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp" />

            <!-- Title (Fixed, never scrolls) -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Products"
                android:textColor="@color/primary_color"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:letterSpacing="-0.02" />

            <!-- More Options Button -->
            <ImageView
                android:id="@+id/btnMore"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_more_vert"
                android:tint="@color/primary_color"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp" />

        </LinearLayout>

        <!-- Search Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_search_bar"
                android:paddingVertical="12dp"
                android:paddingHorizontal="16dp"
                android:gravity="center_vertical">

                <!-- Search Icon -->
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    android:tint="@color/zinc_400"
                    android:layout_marginEnd="12dp" />

                <!-- Search Input -->
                <EditText
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Search tiles, codes..."
                    android:textColor="@color/primary_color"
                    android:textColorHint="@color/zinc_400"
                    android:textSize="14sp"
                    android:background="@null"
                    android:padding="0dp"
                    android:maxLines="1" />

            </LinearLayout>

        </LinearLayout>

        <!-- Filter Chips Section -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:background="@color/white">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- All Filter -->
                <Button
                    android:id="@+id/btnAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_filter_chip_active"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="20dp"
                    android:layout_marginEnd="8dp"
                    android:stateListAnimator="@null" />

                <!-- Category Filter -->
                <Button
                    android:id="@+id/btnCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category"
                    android:textColor="@color/zinc_600"
                    android:textSize="14sp"
                    android:drawableEnd="@drawable/ic_expand_more"
                    android:drawablePadding="4dp"
                    android:background="@drawable/bg_filter_chip"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="20dp"
                    android:layout_marginEnd="8dp"
                    android:stateListAnimator="@null" />

                <!-- Size Filter -->
                <Button
                    android:id="@+id/btnSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Size"
                    android:textColor="@color/zinc_600"
                    android:textSize="14sp"
                    android:drawableEnd="@drawable/ic_expand_more"
                    android:drawablePadding="4dp"
                    android:background="@drawable/bg_filter_chip"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="20dp"
                    android:layout_marginEnd="8dp"
                    android:stateListAnimator="@null" />

                <!-- Stock Filter -->
                <Button
                    android:id="@+id/btnStock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stock"
                    android:textColor="@color/zinc_600"
                    android:textSize="14sp"
                    android:drawableEnd="@drawable/ic_expand_more"
                    android:drawablePadding="4dp"
                    android:background="@drawable/bg_filter_chip"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="20dp"
                    android:stateListAnimator="@null" />

            </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>

    <!-- Products List (Scrolls independently below the fixed header) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewProducts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerSection"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="90dp"
        android:scrollbars="vertical" />

    <!-- Add Product Button (Circular FAB Style) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btnAddProduct"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#000000"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="24dp"
        android:layout_marginEnd="24dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_add"
            android:tint="@color/white"
            android:layout_gravity="center" />

    </androidx.cardview.widget.CardView>

</RelativeLayout>