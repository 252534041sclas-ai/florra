<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Item"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#111118"
        android:layout_marginBottom="16dp" />

    <AutoCompleteTextView
        android:id="@+id/etItemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Item Name"
        android:background="@drawable/bg_input_field"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        android:completionThreshold="1" />

    <AutoCompleteTextView
        android:id="@+id/etItemNo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Product Number (Tile No)"
        android:background="@drawable/bg_input_field"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        android:completionThreshold="1" />

    <EditText
        android:id="@+id/etItemSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Size (e.g. 60x120cm)"
        android:background="@drawable/bg_input_field"
        android:padding="12dp"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etItemQty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Quantity"
            android:inputType="number"
            android:background="@drawable/bg_input_field"
            android:padding="12dp"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/etItemRate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Rate (per unit)"
            android:inputType="numberDecimal"
            android:background="@drawable/bg_input_field"
            android:padding="12dp"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>
