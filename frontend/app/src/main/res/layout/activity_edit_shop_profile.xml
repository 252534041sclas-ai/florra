<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_50">

    <!-- Header Toolbar -->
    <RelativeLayout
        android:id="@+id/headerToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:elevation="2dp"
        android:paddingHorizontal="16dp">

        <RelativeLayout
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_circle_gray"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_back"
                android:tint="@color/slate_700"
                android:layout_centerInParent="true" />
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Shop Profile"
            android:textColor="@color/slate_900"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/btnBack"
            android:layout_marginStart="16dp" />
    </RelativeLayout>

    <!-- Scrollable Form Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerToolbar"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Logo Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginBottom="24dp">

                <RelativeLayout
                    android:id="@+id/btnChangeLogo"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_icon_circle_gray"
                    android:clickable="true"
                    android:focusable="true">

                    <!-- Default Shop Icon -->
                    <ImageView
                        android:id="@+id/ivShopLogo"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_grid_view"
                        android:tint="@color/slate_500"
                        android:layout_centerInParent="true" />

                    <!-- Overlay Edit indicator -->
                    <RelativeLayout
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_black_button"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentEnd="true"
                        android:layout_margin="2dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_edit"
                            android:tint="@color/white"
                            android:layout_centerInParent="true" />
                    </RelativeLayout>
                </RelativeLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Change Showroom Logo"
                    android:textColor="@color/slate_900"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Will appear on quotations &amp; invoices"
                    android:textColor="@color/slate_400"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Card: Form Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_settings_card"
                android:elevation="1dp"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <!-- Showroom Identity Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SHOWROOM IDENTIFICATION"
                    android:textColor="@color/slate_400"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Showroom Name"
                    android:textColor="@color/slate_700"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/edtShopName"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_edittext"
                    android:paddingHorizontal="12dp"
                    android:hint="Enter Showroom Name"
                    android:textColorHint="@color/slate_300"
                    android:textColor="@color/slate_900"
                    android:textSize="13sp"
                    android:inputType="textPersonName"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Showroom Owner / Manager"
                    android:textColor="@color/slate_700"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/edtShopOwner"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_edittext"
                    android:paddingHorizontal="12dp"
                    android:hint="Enter Owner Full Name"
                    android:textColorHint="@color/slate_300"
                    android:textColor="@color/slate_900"
                    android:textSize="13sp"
                    android:inputType="textPersonName"
                    android:layout_marginBottom="24dp" />

                <!-- Contact details Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONTACT DETAILS"
                    android:textColor="@color/slate_400"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phone Number"
                    android:textColor="@color/slate_700"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/edtShopPhone"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_edittext"
                    android:paddingHorizontal="12dp"
                    android:hint="Enter Storefront Phone"
                    android:textColorHint="@color/slate_300"
                    android:textColor="@color/slate_900"
                    android:textSize="13sp"
                    android:inputType="phone"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email Address"
                    android:textColor="@color/slate_700"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/edtShopEmail"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_edittext"
                    android:paddingHorizontal="12dp"
                    android:hint="Enter Support Email"
                    android:textColorHint="@color/slate_300"
                    android:textColor="@color/slate_900"
                    android:textSize="13sp"
                    android:inputType="textEmailAddress"
                    android:layout_marginBottom="24dp" />

                <!-- Business parameters -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TAXATION &amp; BUSINESS PARAMETERS"
                    android:textColor="@color/slate_400"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GSTIN Number"
                    android:textColor="@color/slate_700"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/edtShopGst"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_edittext"
                    android:paddingHorizontal="12dp"
                    android:hint="Enter GSTIN (e.g. 24ABCDE1234F1Z5)"
                    android:textColorHint="@color/slate_300"
                    android:textColor="@color/slate_900"
                    android:textSize="13sp"
                    android:inputType="textCapCharacters"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Default Wastage Margin (%)"
                    android:textColor="@color/slate_700"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/edtShopWastage"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_edittext"
                    android:paddingHorizontal="12dp"
                    android:hint="Standard tile wastage (default is 8%)"
                    android:textColorHint="@color/slate_300"
                    android:textColor="@color/slate_900"
                    android:textSize="13sp"
                    android:inputType="numberDecimal"
                    android:layout_marginBottom="24dp" />

                <!-- Location details -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PHYSICAL LOCATION"
                    android:textColor="@color/slate_400"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Showroom Physical Address"
                    android:textColor="@color/slate_700"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/edtShopAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="2"
                    android:gravity="top|left"
                    android:background="@drawable/bg_edittext"
                    android:padding="12dp"
                    android:hint="Enter full showroom storefront street, area, city, and state details..."
                    android:textColorHint="@color/slate_300"
                    android:textColor="@color/slate_900"
                    android:textSize="13sp"
                    android:inputType="textMultiLine" />
            </LinearLayout>

            <!-- Save CTA Button -->
            <RelativeLayout
                android:id="@+id/btnSaveShopProfile"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_black_button"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="32dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_centerInParent="true">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_verified"
                        android:tint="@color/white"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Save Showroom Profile"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </RelativeLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
