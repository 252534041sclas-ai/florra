<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f9fafb"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="120dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#ffffff"
                android:elevation="4dp"
                android:layout_marginBottom="16dp">

                <!-- Status Bar Spacer -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:background="#ffffff" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:contentDescription="Back" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Edit Product"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <ImageView
                    android:id="@+id/btnDelete"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_delete"
                    android:contentDescription="Delete" />
                </LinearLayout>
            </LinearLayout>

            <!-- Image Container -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@android:color/white"
                android:padding="12dp"
                android:elevation="4dp">

                <ImageView
                    android:id="@+id/ivProductImage"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:background="#e5e7eb"
                    android:contentDescription="Product Image" />

                <Button
                    android:id="@+id/btnChangePhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentEnd="true"
                    android:layout_margin="12dp"
                    android:background="#ffffff"
                    android:text="Change Photo"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:padding="12dp" />
            </RelativeLayout>

            <!-- Basic Information Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:elevation="4dp"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Basic Information"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#111827"
                    android:layout_marginBottom="12dp" />

                <!-- Tile Name -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tile Name"
                    android:textSize="14sp"
                    android:textColor="#374151"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etTileName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#f9fafb"
                    android:text="Carrara White Marble"
                    android:textSize="16sp"
                    android:textColor="#111827"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginBottom="16dp" />

                <!-- Tile No -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tile No"
                    android:textSize="14sp"
                    android:textColor="#374151"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etTileNo"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#f9fafb"
                    android:hint="e.g. 101"
                    android:textSize="16sp"
                    android:textColor="#111827"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginBottom="16dp" />

                <!-- Brand Name -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Brand Name"
                    android:textSize="14sp"
                    android:textColor="#374151"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etBrandName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#f9fafb"
                    android:text="Florra Ceramics"
                    android:textSize="16sp"
                    android:textColor="#111827"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />
            </LinearLayout>

            <!-- Classification Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:elevation="4dp"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Classification"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#111827"
                    android:layout_marginBottom="12dp" />

                <!-- Category -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Category"
                    android:textSize="14sp"
                    android:textColor="#374151"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spCategory"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#f9fafb"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginBottom="16dp" />

                <!-- Size -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Size"
                    android:textSize="14sp"
                    android:textColor="#374151"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spSize"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#f9fafb"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginBottom="16dp" />

                <!-- Finish -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Finish"
                    android:textSize="14sp"
                    android:textColor="#374151"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <Button
                        android:id="@+id/btnFinishGlossy"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Glossy"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="normal"
                        android:background="@drawable/bg_chip_selected"
                        android:paddingHorizontal="16dp"
                        android:layout_marginEnd="8dp"
                        android:stateListAnimator="@null" />

                    <Button
                        android:id="@+id/btnFinishMatte"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Matte"
                        android:textColor="@color/slate_600"
                        android:textSize="14sp"
                        android:textStyle="normal"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingHorizontal="16dp"
                        android:layout_marginEnd="8dp"
                        android:stateListAnimator="@null" />

                    <Button
                        android:id="@+id/btnFinishSatin"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Satin"
                        android:textColor="@color/slate_600"
                        android:textSize="14sp"
                        android:textStyle="normal"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingHorizontal="16dp"
                        android:layout_marginEnd="8dp"
                        android:stateListAnimator="@null" />

                    <Button
                        android:id="@+id/btnFinishRustic"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Rustic"
                        android:textColor="@color/slate_600"
                        android:textSize="14sp"
                        android:textStyle="normal"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingHorizontal="16dp"
                        android:stateListAnimator="@null" />

                </LinearLayout>

                <!-- Color -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Color"
                    android:textSize="14sp"
                    android:textColor="#374151"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Select Color"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                    <AutoCompleteTextView
                        android:id="@+id/autoCompleteColor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Pricing & Inventory Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:elevation="4dp"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pricing &amp; Inventory"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#111827"
                    android:layout_marginBottom="12dp" />

                <!-- Price -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Price (₹ per sq/ft)"
                    android:textSize="14sp"
                    android:textColor="#374151"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#f9fafb"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹"
                        android:textSize="18sp"
                        android:textColor="#374151"
                        android:paddingStart="16dp"
                        android:paddingEnd="8dp" />

                    <EditText
                        android:id="@+id/etPrice"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@null"
                        android:inputType="numberDecimal"
                        android:paddingStart="0dp"
                        android:paddingEnd="16dp"
                        android:textSize="16sp"
                        android:textColor="#111827" />
                </LinearLayout>

                <!-- Stock -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Stock Quantity (Boxes)"
                    android:textSize="14sp"
                    android:textColor="#374151"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etStock"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#f9fafb"
                    android:inputType="number"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="16sp"
                    android:textColor="#111827"
                    android:layout_marginBottom="16dp" />
                
                <!-- Description -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Description"
                    android:textSize="14sp"
                    android:textColor="#374151"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="#f9fafb"
                    android:gravity="top|start"
                    android:padding="12dp"
                    android:textSize="14sp"
                    android:textColor="#111827" />

                <!-- Active Switch -->
                 <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Product Active"
                        android:textSize="16sp"
                        android:textColor="#111827" />

                    <Switch
                        android:id="@+id/switchActive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

            </LinearLayout>

            <!-- Bottom Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@android:color/white"
                android:elevation="4dp"
                android:padding="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="40dp">

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="#F9FBFA"
                    android:text="Cancel"
                    android:textColor="#374151"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="#000000"
                    android:text="Save Changes"
                    android:textColor="#ffffff"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Bottom Navigation -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="35dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Dash -->
            <LinearLayout
                android:id="@+id/bottomDashboard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_dashboard"
                    app:tint="@color/zinc_400"/>
            </LinearLayout>

            <!-- Inventory -->
            <LinearLayout
                android:id="@+id/bottomInventory"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_grid_view"
                    app:tint="@color/primary_color"/>
            </LinearLayout>

            <!-- Quotes -->
            <LinearLayout
                android:id="@+id/bottomQuotes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chat"
                    app:tint="@color/zinc_400"/>
            </LinearLayout>

            <!-- Account -->
            <LinearLayout
                android:id="@+id/bottomAccount"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_person"
                    app:tint="@color/zinc_400"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>
