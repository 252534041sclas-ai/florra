<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/white" />
        </shape>
    </item>
    <item android:top="1dp">
         <!-- This effectively creates a top border if the background behind is different, 
              but for a shadow effect usually an elevation on the view is better. 
              Here is a top border simulation. -->
        <shape>
            <solid android:color="@color/white"/>
            <stroke android:width="1dp" android:color="#E5E7EB"/> <!-- gray-200 equivalent -->
        </shape>
    </item>
</layer-list>
